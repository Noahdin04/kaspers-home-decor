# --- Postgres initialization ---
# Read by the official postgres image on FIRST startup only.
# Changing these after the volume exists won't update an already-created DB.
POSTGRES_DB=kaspers
POSTGRES_USER=kaspers_app
POSTGRES_PASSWORD=changeme

# --- Host port ---
# Port published on the server PC (maps to 5432 inside the container).
# Must be unique across the Postgres containers on this server —
# your other two sites use their own ports.
POSTGRES_PORT=5433
